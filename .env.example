# Optional: plug in an AI image-to-image provider later.
# 'local' (default) uses the built-in canvas painterly filter.
# 'openai' | 'replicate' route through stylizeWithAI() in src/services/memoryGenerator.js
VITE_IMAGE_AI_PROVIDER=local
# Recommended: point this at YOUR OWN backend proxy that holds the secret key.
VITE_IMAGE_AI_ENDPOINT=
# Only for local experiments — any VITE_ variable is shipped to the browser.
VITE_IMAGE_AI_KEY=
