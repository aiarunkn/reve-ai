# Copy to .env.local and fill in. .env.local is git-ignored.

# The mind of every world (Claude). Server-side only — no VITE_ prefix.
# Get one at console.anthropic.com → API Keys. On Vercel: Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Scene art for stories (places, character portraits, "illustrate this moment").
# Server-side only. Get one at platform.openai.com → API keys.
OPENAI_API_KEY=
# Optional: OPENAI_IMAGE_MODEL=gpt-image-2.5-flare   OPENAI_IMAGE_QUALITY=medium (or low, cheaper)

# Optional: plug in an AI image-to-image provider later.
# 'local' (default) uses the built-in canvas painterly filter.
# 'openai' | 'replicate' route through stylizeWithAI() in src/services/memoryGenerator.js
VITE_IMAGE_AI_PROVIDER=local
# Recommended: point this at YOUR OWN backend proxy that holds the secret key.
VITE_IMAGE_AI_ENDPOINT=
# Only for local experiments — any VITE_ variable is shipped to the browser.
VITE_IMAGE_AI_KEY=

# 360° AI worlds (Blockade Labs Skybox AI, "Image2Pano").
# Server-side only — no VITE_ prefix. On Vercel: Project → Settings → Environment Variables.
# Without a key, every memory gets a 360° world painted in the browser instead.
BLOCKADE_API_KEY=
# Optional Skybox style (GET https://backend.blockadelabs.com/api/v1/skybox/styles)
# BLOCKADE_STYLE_ID=155

# Photos of story places (optional). Free key at pexels.com/api. Server-side only.
# Without it, openly licensed photos come from Openverse (no key, fewer good matches).
PEXELS_API_KEY=

# Shared worlds (friends in the same desired reality). See README → Shared worlds.
# Server-side only: lets api/* read and write worlds, players and turns.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser: only for live "someone just played" pings and who's online (no table access).
# Without these, shared worlds still work and check for news every 20 seconds.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
